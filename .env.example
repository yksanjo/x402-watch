# ---- monitor ----
MONITOR_PORT=4040
PER_CALL_CAP_USD=0.5
DAILY_CAP_USD=5
# blank = allow all merchants; otherwise comma-separated hosts
MERCHANT_ALLOWLIST=

# ---- agent ----
MONITOR_URL=http://localhost:4040
AGENT_INTERVAL_MS=1400
# sim = simulated settlement (default, runs anywhere)
# solana = real x402 settlement on Solana devnet
X402_MODE=sim
X402_NETWORK=solana-devnet

# ---- real mode only (X402_MODE=solana) ----
# devnet keypair as a JSON array of bytes, e.g. [12,34,...]
SOLANA_SECRET_KEY=
# the paid endpoint the agent calls; defaults to the bundled local merchant
RESOURCE_URL=http://localhost:4021/regime/latest

# ---- local merchant (real mode only) ----
MERCHANT_PORT=4021
PAY_TO=
FACILITATOR_URL=https://facilitator.payai.network

# ---- alerts (optional) ----
# get pinged on every blocked payment, flagged settlement, and halt toggle
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
